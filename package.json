{
  "name": "chorde",
  "private": true,
  "version": "0.1.4",
  "description": "A modern songbook application for musicians with ChordPro support",
  "keywords": [
    "music",
    "songbook",
    "chordpro",
    "guitar",
    "lyrics",
    "chords"
  ],
  "author": "Chorde Team",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@chorde/web",
    "dev:api": "npm run dev --workspace=@chorde/api",
    "dev:all": "npm run dev --workspace=@chorde/web & npm run dev --workspace=@chorde/api",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "predeploy": "npm run build --workspace=@chorde/web",
    "deploy": "gh-pages -d packages/web/dist"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
