{
  "name": "chorde",
  "private": true,
  "version": "0.3.0",
  "description": "A modern songbook application for musicians with ChordPro support",
  "keywords": [
    "music",
    "songbook",
    "chordpro",
    "guitar",
    "lyrics",
    "chords"
  ],
  "author": "Chorde Team",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@chorde/web",
    "dev:api": "npm run dev --workspace=@chorde/api",
    "dev:all": "npm run dev --workspace=@chorde/web & npm run dev --workspace=@chorde/api",
    "build": "npm run build -w @chorde/shared && npm run build -w @chorde/web && npm run build -w @chorde/api",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "predeploy": "npm run build --workspace=@chorde/web",
    "deploy": "gh-pages -d packages/web/dist",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.58.2"
  }
}
